# Copy this file to .env (never commit .env) — used by local dev and Vercel.
# Required for live checkout:
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Public base URL of the deployed site (no trailing slash). Falls back to
# VERCEL_URL automatically on Vercel, then to siteUrl in data/config.json.
SITE_URL=https://your-art-site.com
